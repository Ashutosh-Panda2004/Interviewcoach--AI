# Server-side deployment key. Leave empty only when every user will use BYOK.
GEMINI_API_KEY=

# Override these when Google deprecates a preview model.
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

PORT=1234
AI_RATE_LIMIT=40
LIVE_RATE_LIMIT=12

# Optional link shown on the Open Source page and footer.
VITE_REPOSITORY_URL=
